# Secrets for the daily post generator (scripts/generate-post.mjs).
# In production these live in GitHub repo Settings -> Secrets and variables ->
# Actions. For a local test, copy to .env.automation and run:
#   node --env-file=.env.automation scripts/generate-post.mjs

# Where to send finished posts: your deployed site URL (no trailing slash).
SITE_URL=https://your-site.com
# Shared secret. MUST match INGEST_SECRET set on the site (Vercel env var).
INGEST_SECRET=

# Writers
GEMINI_API_KEY=          # free: https://aistudio.google.com/apikey
GROQ_API_KEY=            # free fallback: https://console.groq.com/keys  (Groq, not xAI Grok)

# Optional
# PUBLISH=false          # set to false to save drafts instead of publishing live
