# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Admin CMS (/admin) — server-side only, NEVER expose these to the browser ---
# Password you type to sign in at /admin.
ADMIN_PASSWORD=choose-a-strong-password
# Service-role key (Project Settings -> API). Lets the admin read drafts and
# write posts. Keep it secret. Also used by the daily generator script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: profile id to attribute new posts to. Defaults to the first profile.
# AUTHOR_ID=00000000-0000-0000-0000-000000000000
