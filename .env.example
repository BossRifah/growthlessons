# Copy this file to .env.local and fill in real values.
# These power the website + the Payload CMS at /admin.

# --- Payload CMS (required) ---
# Long random string. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-string
# Postgres connection string. In Supabase: Project Settings -> Database ->
# Connection string -> "Connection pooling" (Transaction mode). URL-encode the
# password if it has special characters.
DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Media storage: Supabase Storage (S3-compatible) ---
# Create a public bucket (e.g. "media") and an S3 access key in
# Supabase -> Storage -> S3 connection.
S3_BUCKET=media
S3_REGION=us-east-1
S3_ENDPOINT=https://YOUR-PROJECT.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# --- Daily auto-writer ingest ---
# Shared secret the auto-writer sends to POST /api/posts/ingest. Pick any random
# string; it must match the INGEST_SECRET used by the GitHub Action.
INGEST_SECRET=replace-with-a-random-string
